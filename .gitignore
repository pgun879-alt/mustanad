# Environments
.venv/
venv/
env/

# Secrets and local configuration -- never commit these
.env
.env.*

# Databases and indexed content: these hold the user's documents
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Generated reports and exports -- these contain real operational data
reports/
*.log
*.jsonl
*.csv
*.xlsx

# Always keep the documented placeholder file
!.env.example
