# mustanad configuration.
#
# Copy to .env and edit. .env is git-ignored and must never be committed.
# Every value below is a PLACEHOLDER -- no real credential appears in this file.
# All settings are optional: with none of them set, mustanad runs fully offline.

# ---------------------------------------------------------------- storage
# SQLite file holding documents, chunks and the inverted index.
MUSTANAD_DB_PATH=data/mustanad.sqlite3

# ---------------------------------------------------------------- HTTP API auth
# true  -> the X-API-Key header is required on every /v1 route (MUSTANAD_API_KEYS must be set)
# false -> no authentication. Only ever do this on a trusted local machine.
MUSTANAD_AUTH_REQUIRED=true

# Comma-separated list of accepted API keys. Generate real ones with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MUSTANAD_API_KEYS=replace-me-with-a-generated-key,replace-me-with-another

# Requests per minute per API key.
MUSTANAD_RATE_LIMIT_PER_MINUTE=60

# Comma-separated browser origins allowed to call the API. Empty disables CORS entirely.
MUSTANAD_CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------- answer provider
# extractive -> offline, deterministic, no API key, no network  (default)
# ollama     -> a local Ollama server; free, private, needs a pulled model and RAM
# openai     -> any OpenAI-compatible /chat/completions endpoint; COSTS MONEY
MUSTANAD_PROVIDER=extractive

# Used by the "openai" and "ollama" providers.
MUSTANAD_LLM_MODEL=gpt-4o-mini

# --- only needed when MUSTANAD_PROVIDER=openai ---
MUSTANAD_LLM_BASE_URL=https://api.openai.com/v1
# PLACEHOLDER. Never commit a real key.
MUSTANAD_LLM_API_KEY=sk-replace-me

# --- only needed when MUSTANAD_PROVIDER=ollama ---
MUSTANAD_OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------- cost controls
# These bound spend on a paid provider. Set the daily budget to 0 to block all paid calls.
MUSTANAD_LLM_TIMEOUT_SECONDS=30
MUSTANAD_LLM_MAX_OUTPUT_TOKENS=500
MUSTANAD_LLM_MAX_CONTEXT_CHARS=8000
MUSTANAD_LLM_DAILY_CALL_BUDGET=200

# ---------------------------------------------------------------- retrieval tuning
MUSTANAD_CHUNK_TOKENS=180
MUSTANAD_CHUNK_OVERLAP_TOKENS=40
MUSTANAD_CANDIDATE_POOL=50
MUSTANAD_DEFAULT_TOP_K=5
MUSTANAD_BM25_K1=1.5
MUSTANAD_BM25_B=0.75
# Fraction of the question's terms the best passage must contain before answering at all.
MUSTANAD_MIN_COVERAGE=0.34

# ---------------------------------------------------------------- limits and logging
MUSTANAD_MAX_UPLOAD_BYTES=20971520
MUSTANAD_LOG_LEVEL=INFO
